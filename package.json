{
  "name": "modus-feedback",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain.test.ts",
    "test:integration": "node --import dotenv/config node_modules/vitest/vitest.mjs run --maxWorkers=1 tests/api.test.ts tests/seed.test.ts tests/improvements.test.ts tests/telegram.test.ts tests/security.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:init": "tsx scripts/init.ts",
    "db:reset-admin": "tsx scripts/reset-admin.ts",
    "db:demo": "tsx scripts/seed.ts",
    "db:import": "tsx scripts/import.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "telegram:worker": "tsx scripts/telegram-worker.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.2.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.2.4",
    "argon2": "0.45.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "file-type": "21.3.2",
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "next-intl": "4.14.10",
    "pg": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "2.6.1",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.11",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.27",
    "dotenv": "17.3.1",
    "postcss": "8.5.32",
    "prettier": "3.8.3",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
